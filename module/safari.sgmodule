#!name=Safari 自定义搜索 (DuckDuckGo -> Disroot)
#!desc=将 Safari 的默认 DuckDuckGo 搜索静默重定向到 Disroot 及其他快捷搜索
#!system=mac,ios

[URL Rewrite]
# 1. 快捷搜索：如果输入 "b 关键词"，跳转 Bilibili 搜索
^https?:\/\/duckduckgo\.com\/.*[\?&]q=b\+([^&]+) https://search.bilibili.com/all?keyword=$1 302

# 2. 快捷搜索：如果输入 "tb 关键词"，跳转淘宝搜索
^https?:\/\/duckduckgo\.com\/.*[\?&]q=tb\+([^&]+) https://s.taobao.com/search?q=$1 302

# 3. 兜底默认：将其他普通的 DuckDuckGo 搜索请求全部重定向到 Disroot
^https?:\/\/duckduckgo\.com\/.*[\?&]q=(?!b\+|tb\+)([^&]+) https://search.disroot.org/search?q=$1 302

[MITM]
# 允许 Surge 解密 DuckDuckGo 的流量以便重写生效
hostname = %APPEND% duckduckgo.com
